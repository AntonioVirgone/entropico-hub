# Supabase — trovi questi valori in:
# Supabase Dashboard > Project Settings > Data API (URL)
# e Project Settings > API Keys (chiave "publishable", formato sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# In alternativa, se usi le chiavi legacy, puoi impostare:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Solo lato server (NON anteporre NEXT_PUBLIC_, NON esporre nel browser) ──
# Necessarie per l'API di upload documentazione (/api/projects/[id]/documents).
# service_role key: Project Settings > API Keys > service_role (segreta!)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Chiave a tua scelta per autenticare l'API (Bearer token). Genera un valore lungo e casuale.
DOCS_API_KEY=
