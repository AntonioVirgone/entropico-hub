# Supabase — trovi questi valori in:
# Supabase Dashboard > Project Settings > Data API (URL)
# e Project Settings > API Keys (chiave "publishable", formato sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# In alternativa, se usi le chiavi legacy, puoi impostare:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Solo lato server (NON anteporre NEXT_PUBLIC_, NON esporre nel browser) ──
# Necessaria per l'API documentazione (/api/projects/[id]/documents): risolve i
# token personali e legge/scrive bypassando l'RLS dopo l'autenticazione.
# service_role key: Project Settings > API Keys > service_role (segreta!)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# NOTA: DOCS_API_KEY non è più usata. L'API ora si autentica con i TOKEN
# PERSONALI generati da ogni utente nella pagina "Token API" della web app.

# ── URL pubblico della web app (opzionale) ──
# Usato per generare nel prompt dell'agente AI gli esempi di chiamata REST per
# creare/aggiornare i task (feature "Creare task da AI"). Se assente, nel prompt
# compare un placeholder da sostituire a mano. In locale: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://entropico-hub.vercel.app/
